#!/bin/sh
set -eu

artifacts=${1:?usage: package-release <artifacts-dir> <stage-dir> <shape> <file>...}
stage=${2:?usage: package-release <artifacts-dir> <stage-dir> <shape> <file>...}
shape=${3:?usage: package-release <artifacts-dir> <stage-dir> <shape> <file>...}
shift 3
test "$#" -gt 0 || {
  echo "package-release: no files were given" >&2
  exit 1
}

case "$shape" in
  *[!A-Za-z0-9._-]* | .* | *..*)
    echo "package-release: invalid archive shape: $shape" >&2
    exit 1
    ;;
esac

mkdir -p "$artifacts" "$stage"
root="$stage/$shape"
archive="$artifacts/$shape.tar.gz"
temporary="$archive.tmp.$$"

if ! mkdir "$root"; then
  echo "package-release: staging path already exists: $root" >&2
  exit 1
fi
chmod 755 "$root"
cleanup() {
  rm -rf -- "$root"
  rm -f -- "$temporary"
}
trap cleanup EXIT HUP INT TERM

for source do
  name=${source##*/}
  if [ -e "$root/$name" ]; then
    echo "package-release: two inputs are named $name" >&2
    exit 1
  fi
  cp "$source" "$root/$name"
  if [ -x "$source" ]; then
    chmod 755 "$root/$name"
  else
    chmod 644 "$root/$name"
  fi
done

# The macOS release binary is copied and chmodded above. Re-sign that exact
# staged file after its final mode is set so the archive carries the
# Hypervisor entitlement and a valid ad-hoc code signature. Other package
# shapes leave this unset and remain byte-for-byte unchanged by codesign.
if [ -n "${CHOCK_CODESIGN_ENTITLEMENTS:-}" ]; then
  test -x /usr/bin/codesign || {
    echo "package-release: codesign is required when signing entitlements are configured" >&2
    exit 1
  }
  test -f "$CHOCK_CODESIGN_ENTITLEMENTS" || {
    echo "package-release: entitlement plist not found: $CHOCK_CODESIGN_ENTITLEMENTS" >&2
    exit 1
  }
  test -f "$root/chock" || {
    echo "package-release: entitlement signing requires a chock executable in the package" >&2
    exit 1
  }
  /usr/bin/codesign --force --sign - \
    --entitlements "$CHOCK_CODESIGN_ENTITLEMENTS" "$root/chock"
fi

tar --sort=name \
    --owner=0 --group=0 --numeric-owner \
    --mtime="@${SOURCE_DATE_EPOCH:-0}" \
    -C "$stage" -cf - "$shape" \
  | gzip -n > "$temporary"
mv -f -- "$temporary" "$archive"
