#!/bin/sh
set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT HUP INT TERM

mkdir -p "$scratch/bin" "$scratch/artifacts"
printf 'archive\n' > "$scratch/artifacts/chock-test.tar.gz"

cat > "$scratch/bin/git" <<'EOF'
#!/bin/sh
set -eu
printf 'git %s\n' "$*" >> "$CALLS"
if [ "$1" = ls-remote ] && [ -n "${REMOTE_COMMIT:-}" ]; then
  printf '%s\t%s\n' "$REMOTE_COMMIT" "$4"
fi
EOF

cat > "$scratch/bin/gh" <<'EOF'
#!/bin/sh
set -eu
printf 'gh %s\n' "$*" >> "$CALLS"
if [ "$1 $2" = "release view" ]; then
  if [ -z "${DRAFT_STATE:-}" ]; then
    exit 1
  fi
  printf '%s\n' "$DRAFT_STATE"
fi
EOF

chmod +x "$scratch/bin/git" "$scratch/bin/gh"
export PATH="$scratch/bin:$PATH"
export CALLS="$scratch/calls"

tag=0.1.0-unstable-20261105-abcdef0
commit=abcdef0123456789

REMOTE_COMMIT='' DRAFT_STATE='' \
  "$here/publish-rolling-release" "$tag" "$commit" "$scratch/artifacts"
grep -Fx "git tag $tag $commit" "$CALLS"
grep -Fx "git push origin refs/tags/$tag" "$CALLS"
grep -F "gh release create $tag --draft --prerelease" "$CALLS"
grep -F "gh release upload $tag $scratch/artifacts/chock-test.tar.gz --clobber" "$CALLS"
grep -Fx "gh release edit $tag --draft=false" "$CALLS"

: > "$CALLS"
REMOTE_COMMIT=$commit DRAFT_STATE=true \
  "$here/publish-rolling-release" "$tag" "$commit" "$scratch/artifacts"
if grep -Fq "git tag " "$CALLS" || grep -Fq "release create" "$CALLS"; then
  echo "a resumed draft recreated its tag or release" >&2
  exit 1
fi
grep -F "gh release upload $tag $scratch/artifacts/chock-test.tar.gz --clobber" "$CALLS"
grep -Fx "gh release edit $tag --draft=false" "$CALLS"

: > "$CALLS"
REMOTE_COMMIT=$commit DRAFT_STATE=false \
  "$here/publish-rolling-release" "$tag" "$commit" "$scratch/artifacts"
if grep -Fq "release upload" "$CALLS" || grep -Fq "release edit" "$CALLS"; then
  echo "a published immutable release was changed" >&2
  exit 1
fi

: > "$CALLS"
if REMOTE_COMMIT=deadbeef DRAFT_STATE='' \
  "$here/publish-rolling-release" "$tag" "$commit" "$scratch/artifacts" 2>/dev/null; then
  echo "a tag at another commit was accepted" >&2
  exit 1
fi
if grep -Fq "git tag " "$CALLS" || grep -Fq "release create" "$CALLS"; then
  echo "a conflicting tag changed release state" >&2
  exit 1
fi

mkdir "$scratch/empty"
: > "$CALLS"
if REMOTE_COMMIT='' DRAFT_STATE='' \
  "$here/publish-rolling-release" "$tag" "$commit" "$scratch/empty" 2>/dev/null; then
  echo "an empty artifact directory was accepted" >&2
  exit 1
fi
if [ -s "$CALLS" ]; then
  echo "an empty artifact directory changed release state" >&2
  exit 1
fi
