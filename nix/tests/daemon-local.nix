{ pkgs, self }:
let
  chock = pkgs.chock.overrideAttrs (_: {
    doCheck = false;
  });
in
pkgs.testers.runNixOSTest {
  name = "chock-daemon-local-auth";

  # A runner without KVM must still run this. qemu takes `accel=kvm:tcg`, so
  # it emulates where it cannot accelerate.
  requiredFeatures.kvm = false;

  nodes.machine = { ... }: {
    imports = [ self.nixosModules.chock-daemon ];
    environment.systemPackages = [
      pkgs.curl
      pkgs.sqlite
    ];
    services.chock-daemon.enable = true;
    services.chock-daemon.package = chock;
    services.chock-daemon.web.enable = true;
    services.chock-daemon.web.project = "/srv/chock-workspace";
    services.chock-daemon.web.externalUrl = "http://127.0.0.1:7374";
    systemd.tmpfiles.rules = [ "d /srv/chock-workspace 0750 chock chock -" ];
  };

  testScript = ''
    import datetime as dt

    def command(label, text):
        print(f"nixos-test: {label}", flush=True)
        return machine.succeed(text, timeout=dt.timedelta(seconds=120))

    def wait_for(label, text):
        print(f"nixos-test: waiting for {label}", flush=True)
        return machine.wait_until_succeeds(text, timeout=dt.timedelta(seconds=120))

    curl = "runuser -u chock -- curl"
    socket = "--unix-socket /run/chock-web/serve.sock"
    origin = "-H 'Origin: http://127.0.0.1:7374'"
    machine.start()
    wait_for("daemon", "systemctl is-active --quiet chock-daemon.service")
    wait_for("web gateway", "systemctl is-active --quiet chock-web.service")
    wait_for("gateway socket", "test -S /run/chock-web/serve.sock")
    command("first-run status", f"{curl} --fail --silent {socket} http://localhost/api/auth/status | grep -q 'setup.*true'")
    command("setup page serves the Phantom app", f"{curl} --fail --silent --compressed {socket} http://localhost/auth/login | grep -q 'boot.js'")
    command("setup page serves Phantom WASM", f"{curl} --fail --silent --compressed --output /dev/null {socket} http://localhost/chock-web.wasm")
    command("create first administrator through Phantom", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' -c /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' -H 'X-Chock-Phantom-Auth: true' --data '{{\"username\":\"nixos-admin\",\"password\":\"correct horse battery staple\"}}' http://localhost/api/setup/local | grep -qx 200")
    command("local mode enabled", f"{curl} --fail --silent {socket} http://localhost/api/auth/status | grep -q 'mode.*local'")
    command("instance admin provisions local member", f"{curl} --silent --fail --cookie /tmp/chock-admin.cookies --cookie-jar /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data '{{\"action\":\"create_local\",\"username\":\"team.member\",\"password\":\"member password one\"}}' http://localhost/api/people | grep -q identity_id")
    command("directory marks local account", f"{curl} --fail --silent --cookie /tmp/chock-admin.cookies {socket} http://localhost/api/people | grep -q 'local_account.*true'")
    command("local member signs in through Phantom", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' -c /tmp/chock-member.cookies {socket} {origin} -H 'Content-Type: application/json' -H 'X-Chock-Phantom-Auth: true' --data '{{\"username\":\"team.member\",\"password\":\"member password one\"}}' http://localhost/api/auth/local | grep -qx 200")
    command("local member is not an instance admin", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' --cookie /tmp/chock-member.cookies {socket} http://localhost/api/people | grep -qx 403")
    command("admin promotes a signed-in member", "member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); payload=$(printf '{\\\"action\\\":\\\"set_instance_role\\\",\\\"identity_id\\\":\\\"%s\\\",\\\"role\\\":\\\"instance_admin\\\"}' \"$member_id\"); runuser -u chock -- curl --fail --silent --cookie /tmp/chock-admin.cookies --unix-socket /run/chock-web/serve.sock -H 'Origin: http://127.0.0.1:7374' -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/people | grep -q 'instance_admin'")
    command("promoted member can access the people directory", f"{curl} --fail --silent --cookie /tmp/chock-member.cookies {socket} http://localhost/api/people | grep -q 'team.member'")
    command("admin demotes the member", "member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); payload=$(printf '{\\\"action\\\":\\\"set_instance_role\\\",\\\"identity_id\\\":\\\"%s\\\",\\\"role\\\":\\\"member\\\"}' \"$member_id\"); runuser -u chock -- curl --fail --silent --cookie /tmp/chock-admin.cookies --unix-socket /run/chock-web/serve.sock -H 'Origin: http://127.0.0.1:7374' -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/people | grep -q member")
    command("last instance admin cannot be demoted", "admin_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'nixos-admin'\"); payload=$(printf '{\\\"action\\\":\\\"set_instance_role\\\",\\\"identity_id\\\":\\\"%s\\\",\\\"role\\\":\\\"member\\\"}' \"$admin_id\"); code=$(runuser -u chock -- curl --silent --output /dev/null --write-out '%{http_code}' --cookie /tmp/chock-admin.cookies --unix-socket /run/chock-web/serve.sock -H 'Origin: http://127.0.0.1:7374' -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/people); test \"$code\" = 409")
    command("non-admin project provisioning explains the local-path restriction", f"code=$({curl} --silent --output /tmp/chock-project-denied.txt --write-out '%{{http_code}}' --cookie /tmp/chock-member.cookies {socket} {origin} -H 'Content-Type: application/json' --data '{{\"name\":\"Denied project\",\"root\":\"/tmp/chock-denied-project\"}}' http://localhost/api/projects); test \"$code\" = 403 && grep -q 'registering an existing daemon path is reserved for instance administrators' /tmp/chock-project-denied.txt")
    command("missing project directory explains the daemon provisioning failure", f"code=$({curl} --silent --output /tmp/chock-project-missing.txt --write-out '%{{http_code}}' --cookie /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data '{{\"name\":\"Missing project\",\"root\":\"/var/lib/chock/not-a-project\"}}' http://localhost/api/projects); test \"$code\" = 422 && grep -q 'the daemon could not open the project directory' /tmp/chock-project-missing.txt && grep -q 'accessible to the daemon account' /tmp/chock-project-missing.txt")
    command("unapproved repository host explains the allowlist requirement", f"code=$({curl} --silent --output /tmp/chock-project-host.txt --write-out '%{{http_code}}' --cookie /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data '{{\"name\":\"Unapproved repository\",\"repository_url\":\"https://example.invalid/team/project.git\"}}' http://localhost/api/projects); test \"$code\" = 403 && grep -q 'repository host is not allowed' /tmp/chock-project-host.txt && grep -q 'CHOCK_GIT_ALLOWED_HOSTS' /tmp/chock-project-host.txt")
    command("admin creates team", f"code=$({curl} --silent --output /tmp/chock-team-create.json --write-out '%{{http_code}}' --cookie /tmp/chock-admin.cookies --cookie-jar /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data '{{\"name\":\"Revocation test\"}}' http://localhost/api/teams); echo status=$code; cat /tmp/chock-team-create.json; test \"$code\" = 200")
    command("admin adds team member", "team_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT id FROM teams WHERE name = 'Revocation test'\"); member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); payload=$(printf '{\\\"identity_id\\\":\\\"%s\\\",\\\"role\\\":\\\"member\\\"}' \"$member_id\"); runuser -u chock -- curl --fail --silent --cookie /tmp/chock-admin.cookies --cookie-jar /tmp/chock-admin.cookies --unix-socket /run/chock-web/serve.sock -H 'Origin: http://127.0.0.1:7374' -H 'Content-Type: application/json' --data \"$payload\" \"http://localhost/api/team-members?team=$team_id\" | grep -q 'updated'")
    command("team member role is visible", "team_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT id FROM teams WHERE name = 'Revocation test'\"); member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); runuser -u chock -- curl --fail --silent --cookie /tmp/chock-admin.cookies --unix-socket /run/chock-web/serve.sock \"http://localhost/api/team-members?team=$team_id\" | grep -q \\\"$member_id.*member\\\"")
    command("team member cannot remove self", "team_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT id FROM teams WHERE name = 'Revocation test'\"); member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); payload=$(printf '{\\\"identity_id\\\":\\\"%s\\\",\\\"role\\\":\\\"remove\\\"}' \"$member_id\"); runuser -u chock -- curl --silent --output /dev/null --write-out '%{http_code}' --cookie /tmp/chock-member.cookies --unix-socket /run/chock-web/serve.sock -H 'Origin: http://127.0.0.1:7374' -H 'Content-Type: application/json' --data \"$payload\" \"http://localhost/api/team-members?team=$team_id\" | grep -qx 403")
    command("team owner removes member", "team_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT id FROM teams WHERE name = 'Revocation test'\"); member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); payload=$(printf '{\\\"identity_id\\\":\\\"%s\\\",\\\"role\\\":\\\"remove\\\"}' \"$member_id\"); runuser -u chock -- curl --fail --silent --cookie /tmp/chock-admin.cookies --cookie-jar /tmp/chock-admin.cookies --unix-socket /run/chock-web/serve.sock -H 'Origin: http://127.0.0.1:7374' -H 'Content-Type: application/json' --data \"$payload\" \"http://localhost/api/team-members?team=$team_id\" | grep -q 'updated'")
    command("team-derived access is revoked", f"{curl} --fail --silent --cookie /tmp/chock-member.cookies {socket} http://localhost/api/teams | grep -qx '\\[\\]'")

    command("prepare a local project for client hosting", "install -d -o chock -g chock /srv/chock-workspace")
    command("local administrator provisions a project", f"{curl} --fail --silent --cookie /tmp/chock-admin.cookies --cookie-jar /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data '{{\"name\":\"Worker project\",\"root\":\"/srv/chock-workspace\"}}' http://localhost/api/projects | grep -q 'Worker project'")
    command("project manager archives without deleting workspace", f"project_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT id FROM daemon_projects WHERE name = 'Worker project'\"); payload=$(printf '{{\\\"action\\\":\\\"set_status\\\",\\\"project_id\\\":\\\"%s\\\",\\\"status\\\":\\\"archived\\\"}}' \"$project_id\"); {curl} --fail --silent --cookie /tmp/chock-admin.cookies --cookie-jar /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/projects | grep -q 'updated'; test -d /srv/chock-workspace; sqlite3 /var/lib/chock/daemon.sqlite \"SELECT status FROM daemon_projects WHERE id = '$project_id'\" | grep -qx archived")
    command("archived project refuses new sessions", f"code=$({curl} --silent --output /dev/null --write-out '%{{http_code}}' --cookie /tmp/chock-admin.cookies {socket} {origin} -X POST 'http://localhost/api/create?project=%2Fsrv%2Fchock-workspace&placement=client'); test \"$code\" = 409")
    command("ordinary member cannot archive a project", "project_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT id FROM daemon_projects WHERE name = 'Worker project'\"); payload=$(printf '{\\\"action\\\":\\\"set_status\\\",\\\"project_id\\\":\\\"%s\\\",\\\"status\\\":\\\"ready\\\"}' \"$project_id\"); code=$(runuser -u chock -- curl --silent --output /dev/null --write-out '%{http_code}' --cookie /tmp/chock-member.cookies --unix-socket /run/chock-web/serve.sock -H 'Origin: http://127.0.0.1:7374' -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/projects); test \"$code\" = 403")
    command("project manager restores archived project", f"project_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT id FROM daemon_projects WHERE name = 'Worker project'\"); payload=$(printf '{{\\\"action\\\":\\\"set_status\\\",\\\"project_id\\\":\\\"%s\\\",\\\"status\\\":\\\"ready\\\"}}' \"$project_id\"); {curl} --fail --silent --cookie /tmp/chock-admin.cookies --cookie-jar /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/projects | grep -q 'updated'; sqlite3 /var/lib/chock/daemon.sqlite \"SELECT status FROM daemon_projects WHERE id = '$project_id'\" | grep -qx ready")
    command("local-account service creates a client session", f"{curl} --fail --silent --cookie /tmp/chock-admin.cookies {socket} {origin} -X POST 'http://localhost/api/create?project=%2Fsrv%2Fchock-workspace&placement=client' > /tmp/chock-client-session.txt; test \"$(cut -f1 /tmp/chock-client-session.txt | wc -c)\" -eq 27")
    command("client session is owned and registered", "session_id=$(cut -f1 /tmp/chock-client-session.txt); admin_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'nixos-admin'\"); sqlite3 /var/lib/chock/daemon.sqlite \"SELECT COUNT(*) FROM daemon_sessions s JOIN session_members m ON m.session_id = s.id WHERE s.id = '$session_id' AND s.placement = 'client' AND m.identity_id = '$admin_id' AND m.role = 'owner'\" | grep -qx 1")
    command("project-scoped session list applies per-session view denials", "project_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT id FROM daemon_projects WHERE name = 'Worker project'\"); session_id=$(cut -f1 /tmp/chock-client-session.txt); member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); payload=$(printf '{\\\"resource_kind\\\":\\\"project\\\",\\\"resource_id\\\":\\\"%s\\\",\\\"principal_kind\\\":\\\"identity\\\",\\\"principal_id\\\":\\\"%s\\\",\\\"capability\\\":\\\"project_view\\\",\\\"effect\\\":\\\"allow\\\"}' \"$project_id\" \"$member_id\"); runuser -u chock -- curl --fail --silent --cookie /tmp/chock-admin.cookies --unix-socket /run/chock-web/serve.sock -H 'Origin: http://127.0.0.1:7374' -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/acl-rules > /dev/null; payload=$(printf '{\\\"resource_kind\\\":\\\"session\\\",\\\"resource_id\\\":\\\"%s\\\",\\\"principal_kind\\\":\\\"identity\\\",\\\"principal_id\\\":\\\"%s\\\",\\\"capability\\\":\\\"session_view\\\",\\\"effect\\\":\\\"deny\\\"}' \"$session_id\" \"$member_id\"); runuser -u chock -- curl --fail --silent --cookie /tmp/chock-admin.cookies --unix-socket /run/chock-web/serve.sock -H 'Origin: http://127.0.0.1:7374' -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/acl-rules > /dev/null; runuser -u chock -- curl --fail --silent --cookie /tmp/chock-member.cookies --unix-socket /run/chock-web/serve.sock http://localhost/api/sessions > /tmp/chock-member-sessions.json; ! grep -q \"$session_id\" /tmp/chock-member-sessions.json")
    command("session presence lease is identity-backed and shared with authorized viewers", f"session_id=$(cut -f1 /tmp/chock-client-session.txt); {curl} --fail --silent --cookie /tmp/chock-admin.cookies --cookie-jar /tmp/chock-admin.cookies {socket} {origin} -X POST \"http://localhost/api/session-presence?session=$session_id\" | grep -q 'present.*true'; admin_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'nixos-admin'\"); {curl} --fail --silent --cookie /tmp/chock-admin.cookies {socket} \"http://localhost/api/session-presence?session=$session_id\" > /tmp/chock-presence.json; grep -q \"$admin_id\" /tmp/chock-presence.json; sqlite3 /var/lib/chock/daemon.sqlite \"SELECT COUNT(*) FROM session_presence WHERE session_id = '$session_id' AND identity_id = '$admin_id'\" | grep -qx 1")
    command("local account provisions its client worker", f"session_id=$(cut -f1 /tmp/chock-client-session.txt); payload=$(printf '{{\"session\":\"%s\"}}' \"$session_id\"); {curl} --fail --silent --cookie /tmp/chock-admin.cookies --cookie-jar /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/worker/token > /tmp/chock-worker-token.json; sed -n 's/.*\\\"token\\\":\\\"\\([^\\\"]*\\)\\\".*/\\1/p' /tmp/chock-worker-token.json | grep -Eq '^[A-Za-z0-9_-]{{43}}$'")
    command("client worker claims a lease", "session_id=$(cut -f1 /tmp/chock-client-session.txt); runuser -u chock -- curl --fail --silent --cookie /tmp/chock-admin.cookies --unix-socket /run/chock-web/serve.sock -H 'Origin: http://127.0.0.1:7374' -H 'Content-Type: application/json' --data \"{\\\"action\\\":\\\"claim\\\",\\\"session\\\":\\\"$session_id\\\",\\\"placement\\\":\\\"client\\\",\\\"host_id\\\":\\\"00000000-0000-4000-8000-000000000101\\\"}\" http://localhost/api/session-host > /tmp/chock-worker-lease.json; grep -q '\\\"generation\\\":1' /tmp/chock-worker-lease.json")
    command("scoped worker can poll its session", "session_id=$(cut -f1 /tmp/chock-client-session.txt); token=$(sed -n 's/.*\"token\":\"\\([^\"]*\\)\".*/\\1/p' /tmp/chock-worker-token.json); runuser -u chock -- curl --fail --silent --unix-socket /run/chock-web/serve.sock -H \"Authorization: Bearer $token\" \"http://localhost/api/worker/commands?session=$session_id&host_id=00000000-0000-4000-8000-000000000101&generation=1&after=0\" | grep -q '\"events\":\\[\\]'")
    command("worker credential cannot use browser project API", "token=$(sed -n 's/.*\"token\":\"\\([^\"]*\\)\".*/\\1/p' /tmp/chock-worker-token.json); code=$(runuser -u chock -- curl --silent --output /dev/null --write-out '%{http_code}' --unix-socket /run/chock-web/serve.sock -H \"Authorization: Bearer $token\" http://localhost/api/projects); test \"$code\" = 401")
    command("second client host cannot steal a live lease", f"session_id=$(cut -f1 /tmp/chock-client-session.txt); code=$({curl} --silent --output /dev/null --write-out '%{{http_code}}' --cookie /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data \"{{\\\"action\\\":\\\"claim\\\",\\\"session\\\":\\\"$session_id\\\",\\\"placement\\\":\\\"client\\\",\\\"host_id\\\":\\\"00000000-0000-4000-8000-000000000102\\\"}}\" http://localhost/api/session-host); test \"$code\" = 403")
    command("owner releases the client host", "session_id=$(cut -f1 /tmp/chock-client-session.txt); runuser -u chock -- curl --fail --silent --cookie /tmp/chock-admin.cookies --unix-socket /run/chock-web/serve.sock -H 'Origin: http://127.0.0.1:7374' -H 'Content-Type: application/json' --data \"{\\\"action\\\":\\\"release\\\",\\\"session\\\":\\\"$session_id\\\",\\\"host_id\\\":\\\"00000000-0000-4000-8000-000000000101\\\",\\\"generation\\\":1}\" http://localhost/api/session-host | grep -q '\\\"released\\\":true'")
    command("replacement host receives a new fence", "session_id=$(cut -f1 /tmp/chock-client-session.txt); token=$(sed -n 's/.*\"token\":\"\\([^\"]*\\)\".*/\\1/p' /tmp/chock-worker-token.json); runuser -u chock -- curl --fail --silent --unix-socket /run/chock-web/serve.sock -H \"Authorization: Bearer $token\" -H 'Content-Type: application/json' --data \"{\\\"action\\\":\\\"claim\\\",\\\"session\\\":\\\"$session_id\\\",\\\"placement\\\":\\\"client\\\",\\\"host_id\\\":\\\"00000000-0000-4000-8000-000000000102\\\"}\" http://localhost/api/session-host | grep -q '\"generation\":2'")
    command("stale worker cannot release replacement lease", "session_id=$(cut -f1 /tmp/chock-client-session.txt); token=$(sed -n 's/.*\"token\":\"\\([^\"]*\\)\".*/\\1/p' /tmp/chock-worker-token.json); code=$(runuser -u chock -- curl --silent --output /dev/null --write-out '%{http_code}' --unix-socket /run/chock-web/serve.sock -H \"Authorization: Bearer $token\" -H 'Content-Type: application/json' --data \"{\\\"action\\\":\\\"release\\\",\\\"session\\\":\\\"$session_id\\\",\\\"host_id\\\":\\\"00000000-0000-4000-8000-000000000101\\\",\\\"generation\\\":1}\" http://localhost/api/session-host); test \"$code\" = 403")
    command("replacement generation can still poll", "session_id=$(cut -f1 /tmp/chock-client-session.txt); token=$(sed -n 's/.*\"token\":\"\\([^\"]*\\)\".*/\\1/p' /tmp/chock-worker-token.json); runuser -u chock -- curl --fail --silent --unix-socket /run/chock-web/serve.sock -H \"Authorization: Bearer $token\" \"http://localhost/api/worker/commands?session=$session_id&host_id=00000000-0000-4000-8000-000000000102&generation=2&after=0\" | grep -q '\"events\":\\[\\]'")

    command("create a daemon-hosted session for import", f"{curl} --fail --silent --cookie /tmp/chock-admin.cookies {socket} {origin} -X POST 'http://localhost/api/create?project=%2Fsrv%2Fchock-workspace' > /tmp/chock-import-session.txt; test \"$(cut -f1 /tmp/chock-import-session.txt | wc -c)\" -eq 27")
    command("remove only the service registration before import", "session_id=$(cut -f1 /tmp/chock-import-session.txt); test \"$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT COUNT(*) FROM daemon_sessions WHERE id = '$session_id'\")\" -eq 1; test \"$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT COUNT(*) FROM session_members WHERE session_id = '$session_id'\")\" -eq 1; sqlite3 /var/lib/chock/daemon.sqlite \"DELETE FROM session_members WHERE session_id = '$session_id'; DELETE FROM daemon_sessions WHERE id = '$session_id';\"; test \"$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT COUNT(*) FROM daemon_sessions WHERE id = '$session_id'\")\" -eq 0; test \"$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT COUNT(*) FROM session_members WHERE session_id = '$session_id'\")\" -eq 0")
    command("reload the externally updated database", "systemctl restart chock-daemon.service")
    wait_for("daemon after database reload", "systemctl is-active --quiet chock-daemon.service")
    wait_for("daemon socket after database reload", "test -S /run/chock-daemon/daemon.sock")
    wait_for("web gateway after daemon restart", "systemctl is-active --quiet chock-web.service")
    wait_for("gateway socket after daemon restart", "test -S /run/chock-web/serve.sock")
    command("import existing daemon session from Projects API", f"session_id=$(cut -f1 /tmp/chock-import-session.txt); code=$({curl} --silent --output /tmp/chock-import-response.txt --write-out '%{{http_code}}' --cookie /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data \"{{\\\"session\\\":\\\"$session_id\\\"}}\" 'http://localhost/api/session/register?project=%2Fsrv%2Fchock-workspace'); cat /tmp/chock-import-response.txt; test \"$code\" = 200; grep -q registered /tmp/chock-import-response.txt")
    command("import registers the caller as owner", "session_id=$(cut -f1 /tmp/chock-import-session.txt); admin_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'nixos-admin'\"); sqlite3 /var/lib/chock/daemon.sqlite \"SELECT COUNT(*) FROM daemon_sessions s JOIN session_members m ON m.session_id = s.id WHERE s.id = '$session_id' AND s.placement = 'daemon' AND m.identity_id = '$admin_id' AND m.role = 'owner'\" | grep -qx 1")
    command("import keeps the existing session log", "session_id=$(cut -f1 /tmp/chock-import-session.txt); test -f \"$(find /var/lib/chock -type f -name \"$session_id.jsonl\" -print -quit)\"")

    command("member cannot reset local passwords", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' --cookie /tmp/chock-member.cookies {socket} {origin} -H 'Content-Type: application/json' --data '{{\"action\":\"reset_local_password\",\"identity_id\":\"00000000-0000-4000-8000-000000000000\",\"password\":\"temporary member password\"}}' http://localhost/api/people | grep -qx 403")
    command("admin resets local password", f"member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); payload=$(printf '{{\"action\":\"reset_local_password\",\"identity_id\":\"%s\",\"password\":\"temporary password two\"}}' \"$member_id\"); {curl} --silent --fail --cookie /tmp/chock-admin.cookies --cookie-jar /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/people | grep -q 'reset.*true'")
    command("old password rejected after reset", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' {socket} {origin} -H 'Content-Type: application/json' --data '{{\"username\":\"team.member\",\"password\":\"member password one\"}}' http://localhost/api/auth/local | grep -qx 401")
    command("reset revokes member session", "member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); sqlite3 /var/lib/chock/daemon.sqlite \"SELECT COUNT(*) FROM auth_sessions WHERE identity_id = '$member_id'\" | grep -qx 0")
    command("new password accepted after reset", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' -c /tmp/chock-member-new.cookies {socket} {origin} -H 'Content-Type: application/json' --data '{{\"username\":\"team.member\",\"password\":\"temporary password two\"}}' http://localhost/api/auth/local | grep -qx 303")
    command("second browser login is active before changing the password", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' {socket} {origin} -H 'Content-Type: application/json' --data '{{\"username\":\"team.member\",\"password\":\"temporary password two\"}}' http://localhost/api/auth/local | grep -qx 303")
    command("wrong current password cannot change credentials", f"code=$({curl} --silent --output /dev/null --write-out '%{{http_code}}' --cookie /tmp/chock-member-new.cookies {socket} {origin} -H 'Content-Type: application/json' --data '{{\"current_password\":\"wrong current password\",\"new_password\":\"member password three\"}}' http://localhost/api/auth/password); test \"$code\" = 403")
    command("local account changes its own password", f"{curl} --silent --fail --cookie /tmp/chock-member-new.cookies {socket} {origin} -H 'Content-Type: application/json' --data '{{\"current_password\":\"temporary password two\",\"new_password\":\"member password three\"}}' http://localhost/api/auth/password | grep -q 'changed.*true'")
    command("self-service password change preserves current login", f"{curl} --fail --silent --cookie /tmp/chock-member-new.cookies {socket} http://localhost/api/teams | grep -qx '\\[\\]'")
    command("self-service password change revokes other sessions", "member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); sqlite3 /var/lib/chock/daemon.sqlite \"SELECT COUNT(*) FROM auth_sessions WHERE identity_id = '$member_id'\" | grep -qx 1")
    command("old password rejected after self-service change", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' {socket} {origin} -H 'Content-Type: application/json' --data '{{\"username\":\"team.member\",\"password\":\"temporary password two\"}}' http://localhost/api/auth/local | grep -qx 401")
    command("new password accepted after self-service change", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' {socket} {origin} -H 'Content-Type: application/json' --data '{{\"username\":\"team.member\",\"password\":\"member password three\"}}' http://localhost/api/auth/local | grep -qx 303")
    command("admin disables local member", f"member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); payload=$(printf '{{\"action\":\"set_local_account_enabled\",\"identity_id\":\"%s\",\"enabled\":false}}' \"$member_id\"); {curl} --silent --fail --cookie /tmp/chock-admin.cookies --cookie-jar /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/people | grep -q 'enabled.*false'")
    command("disabled member sessions revoked", "member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); sqlite3 /var/lib/chock/daemon.sqlite \"SELECT COUNT(*) FROM auth_sessions WHERE identity_id = '$member_id'\" | grep -qx 0")
    command("disabled member cannot sign in", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' {socket} {origin} -H 'Content-Type: application/json' --data '{{\"username\":\"team.member\",\"password\":\"member password three\"}}' http://localhost/api/auth/local | grep -qx 401")
    command("last local admin cannot be disabled", f"admin_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'nixos-admin'\"); payload=$(printf '{{\"action\":\"set_local_account_enabled\",\"identity_id\":\"%s\",\"enabled\":false}}' \"$admin_id\"); code=$({curl} --silent --output /dev/null --write-out '%{{http_code}}' --cookie /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/people); test \"$code\" = 409")
    command("admin re-enables local member", f"member_id=$(sqlite3 /var/lib/chock/daemon.sqlite \"SELECT identity_id FROM local_auth_users WHERE username = 'team.member'\"); payload=$(printf '{{\"action\":\"set_local_account_enabled\",\"identity_id\":\"%s\",\"enabled\":true}}' \"$member_id\"); {curl} --silent --fail --cookie /tmp/chock-admin.cookies --cookie-jar /tmp/chock-admin.cookies {socket} {origin} -H 'Content-Type: application/json' --data \"$payload\" http://localhost/api/people | grep -q 'enabled.*true'")
    command("re-enabled account can sign in again", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' {socket} {origin} -H 'Content-Type: application/json' --data '{{\"username\":\"team.member\",\"password\":\"member password three\"}}' http://localhost/api/auth/local | grep -qx 303")
    command("setup cannot be repeated", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' {socket} {origin} -H 'Content-Type: application/json' --data '{{\"username\":\"another-admin\",\"password\":\"correct horse battery staple\"}}' http://localhost/api/setup/local | grep -qx 409")
    command("unauthenticated API rejected", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' {socket} http://localhost/api/projects | grep -qx 401")
    command("wrong password rejected", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' {socket} {origin} -H 'Content-Type: application/json' --data '{{\"username\":\"nixos-admin\",\"password\":\"wrong password\"}}' http://localhost/api/auth/local | grep -qx 401")
    command("password hash persisted", "runuser -u chock -- sqlite3 /var/lib/chock/daemon.sqlite 'SELECT length(password_hash) > 50 FROM local_auth_users' | grep -qx 1")

    command("restart daemon", "systemctl restart chock-daemon.service")
    wait_for("daemon socket after restart", "test -S /run/chock-daemon/daemon.sock")
    wait_for("web gateway after restart", "systemctl is-active --quiet chock-web.service")
    wait_for("local mode survives restart", f"{curl} --fail --silent {socket} http://localhost/api/auth/status | grep -q 'mode.*local'")
    command("correct password accepted after restart", f"{curl} --silent --output /dev/null --write-out '%{{http_code}}' {socket} {origin} -H 'Content-Type: application/json' --data '{{\"username\":\"nixos-admin\",\"password\":\"correct horse battery staple\"}}' http://localhost/api/auth/local | grep -qx 303")
  '';
}
